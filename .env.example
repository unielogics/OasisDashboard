# Dashboard environment contract (copy to .env.local). Nothing here is a secret.
API_ORIGIN=http://localhost:4000          # Next rewrites /api/* to this origin in dev (first-party cookies, no CORS)
NEXT_PUBLIC_APP_ENV=development
OASIS_BACKEND_PATH=../backend             # gen:api reads docs/openapi.json from here
# Visual-parity harness (pinned so original and port render identically)
PARITY_FIXED_NOW=2026-06-13T10:36:00-04:00
PARITY_TZ=America/New_York
PARITY_LOCALE=en-US
PARITY_VIEWPORT=1480x1000
PARITY_NO_SANDBOX=0                       # set 1 only if Chromium's sandbox fails on this host
PLAYWRIGHT_HOST_PLATFORM_OVERRIDE=ubuntu24.04-arm64   # Amazon Linux 2023 aarch64
