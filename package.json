{
  "name": "oasis-dashboard",
  "version": "0.0.0",
  "private": true,
  "description": "Oasis Auto Spa dashboard (Operations, Payments, Settings) compiled from the Claude Design prototypes",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22 <23"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run --passWithNoTests",
    "parity:setup": "node scripts/parity-setup.mjs",
    "check": "pnpm design:verify && pnpm lint && pnpm typecheck && pnpm test",
    "design:verify": "node scripts/verify-design.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.7"
  }
}
